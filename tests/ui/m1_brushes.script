# Milestone 1: block tool, select/move/resize, clone, delete, cancel, 3D pick, undo,
# save/open. 2D input uses world coordinates (wpress/wdrag), independent of layout.
tool block
wpress 1 -254 -237
wdrag -68 49
wdrag 258 275
release
shot m1-01-block-preview.png
expect edges
expect brushes 0
key Return
expect brushes 1
expect selected 1
wpress 1 2 19
wdrag 34 51
release
key Return
expect brushes 2
shot m1-02-two-blocks.png
expect edges
tool select
# move the pillar right by 176 units
wpress 1 18 35
wdrag 132 35
wdrag 178 35
release
shot m1-03-moved-pillar.png
# stretch its top edge in the front view up to z=256
wpress 2 18 62
wdrag 18 188
wdrag 18 254
release
shot m1-04-resized-pillar.png
expect edges
undo
shot m1-05-undo-resize.png
redo
save m1-test.map
open m1-test.map
expect brushes 2
selectall
expect selected 2
shot m1-06-reopened-select-all.png
# click the pillar (x 160..192, y 16..48), then shift+drag clones it 128 units left
wpress 1 176 33
release
expect selected 1
wpress 1 176 33 shift
wdrag 112 33
wdrag 48 33
release
expect brushes 3
shot m1-07-cloned.png
expect edges
key Delete
expect brushes 2
# block tool: Esc cancels the preview, so Return afterwards creates nothing
tool block
wpress 1 -468 249
wdrag -368 149
release
key Esc
key Return
expect brushes 2
# 3D pick selects the floor
tool select
press3d -4 86
release
expect selected 1
shot m1-08-pick-3d.png
# cmd+click adds the pillar, delete both, undo restores both
wpress 1 176 33 cmd
release
expect selected 2
key Delete
expect brushes 0
undo
expect brushes 2
# rotate the floor 45 degrees: Option+drag its top-right corner to straight above the centre
wpress 1 -68 -151
release
expect selected 1
expect size 512 512 64
wpress 1 256 273 alt
wdrag 172 329
wdrag 0 369
release
expect size 724.08 724.08 64
shot m1-09-rotated-45.png
expect edges
undo
expect size 512 512 64
quit
