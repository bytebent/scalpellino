# Milestone 7: terrain. Make two neighbouring patches, sculpt across their seam in the
# top view (one undo step per drag), smooth, flatten, noise, paint in the 3D view,
# change the grid size, heightmap import, save + open, remove.
block 0 0 -64 512 512 0
block 512 0 -64 1024 512 0
selectall
terrain make 16
expect terrains 2
expect terrainheight 256 256 0
# -- raise across the seam (top view); the circle follows the mouse
tool terrain
terrainset mode raise
terrainset radius 200
terrainset amount 32
terrainset falloff soft
view 1 512 256 0.4
whover 1 512 256
shot m7-01-terrain-tool-circle.png
wpress 1 512 256
wdrag 516 256
release
expect terrainheight 512 256 32
# 12 units either side of the seam (one in each patch): the same height
expect terrainheight 500 256 31.3
expect terrainheight 524 256 31.3
undo
expect terrainheight 512 256 0
redo
expect terrainheight 512 256 32
# a longer stroke: dabs every 40 units (a fifth of the radius), one undo step
wpress 1 60 450
wdrag 140 450
wdrag 220 450
wdrag 300 450
release
undo
expect terrainheight 512 256 32
redo
# -- smooth, flatten (to the start height), noise
terrainset mode smooth
terrainset strength 100
wpress 1 180 450
release
terrainset mode flatten
wpress 1 900 400
wdrag 950 450
release
expect terrainheight 950 450 0
terrainset mode noise
terrainset amount 12
terrainset radius 120
wpress 1 800 120
release
expect edges
shot m7-02-sculpted-top-view.png
# -- paint the second texture from the 3D view (camera looks at the near corner)
texture Tile_19
terrainset mode paint
terrainset radius 300
terrainset strength 80
tool select
key Esc
terrainset mode paint
camera -200 -200 500 45 -40
press3d 0 0
release
press3d -60 -20
release
shot m7-03-painted-3d.png
# -- grid size change keeps the shape
selectall
terrain make 32
expect terrains 2
expect terrainheight 512 256 32
# -- heightmap: one round hill over both patches, black 0, white 128
terrain heightmap assets/heightmap-hill.png 0 128
expect terrainheight 512 256 123.5
expect terrainheight 2 2 0
tool select
key Esc
shot m7-04-heightmap-hill.png
selectall
# -- moving the brushes carries the terrain along
transform move 0 0 64
expect terrainheight 512 256 187.5
undo
# -- save + open keeps it all
save m7-test.map
open m7-test.map
expect terrains 2
expect terrainheight 512 256 123.5
# -- remove terrain from one brush
tool select
key Esc
wpress 1 900 100
release
expect selected 1
terrain remove
expect terrains 1
undo
expect terrains 2
quit
