# Milestone 4: clip (2-point and 3-point), keep modes, hollow, carve.
# A 128 x 128 x 64 block (volume 1048576) at the origin.
tool block
wpress 1 0 0
wdrag 128 128
release
key Return
expect brushes 1
expect volume 1048576
# -- 2-point clip: vertical line at x = 32 in the top view, keep both pieces
tool clip
wpress 1 32 -16
wdrag 32 60
wdrag 32 144
release
expect brushes 1
expect edges
shot m4-01-clip-preview.png
key Return
expect brushes 2
expect volume 1048576
expect edges
undo
expect brushes 1
# -- 3-point clip: a slope z = 64 - x/2, keep the front (upper) piece = half the block
clippoints 0 0 64  0 128 64  128 0 0
clipkeep front
shot m4-02-three-point-clip-preview.png
key Return
expect brushes 1
expect volume 524288
expect edges
shot m4-03-three-point-clip-result.png
undo
clipkeep both
# -- hollow with 16-unit walls: 6 walls, volume 128*128*64 - 96*96*32
tool select
selectall
hollow 16
expect brushes 6
expect volume 753664
shot m4-04-hollow.png
undo
expect brushes 1
# -- carve: a 64 x 64 cutter through the middle; pieces + cutter keep the volume,
#    deleting the cutter leaves the hole
tool block
wpress 1 32 32
wdrag 96 96
release
key Return
expect brushes 2
carve
expect brushes 5
expect volume 1048576
expect selected 1
key Delete
expect brushes 4
expect volume 786432
expect edges
shot m4-05-carved.png
quit
