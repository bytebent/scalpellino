# v0.11.0: cameras. Place two with the camera tool (click, Return), the first is active;
# turn with a ring and roll with the roll ring; aim at a clicked and a typed point; make
# the other active, delete the active one, duplicate, orthographic, select with the select
# tool, move by dragging the marker, undo, save + open.
grid 16
block -512 -512 -64 512 512 0
block 200 -100 0 328 100 256
tool camera
cameraset lens 24
cameraset size 1280 720
# top view sets x/y (depth from the last box), the front view then sets y/z
wpress 1 -256 0
release
wpress 2 0 160
release
key Return
expect cameras 1
expect camerasel 1
expect selected 0
expect cameraactive 0
expect cam pos -256 0 160
expect cam lens 24
expect cam size 1280 720
expect cam name camera 1
undo
expect cameras 0
redo
expect cameras 1
expect cameraactive 0
# -- a second camera, typed position: not active (the first stays)
cameraset lens 50
cameraset size 1920 1080
cameraset pos 256 -400 300
key Return
expect cameras 2
expect cameraactive 0
expect cam name camera 2
expect cam angles 0 0 0
# ring around Z in the top view (radius 48 px = 96 units at zoom 0.5): a quarter turn
wpress 1 352 -400
wdrag 328 -330
wdrag 256 -304
release
expect cam angles 0 90 0
expect cam pos 256 -400 300
undo
expect cam angles 0 0 0
redo
expect cam angles 0 90 0
# the roll ring (1.35 x 96 units) around its view direction (+Y): a full circle in the
# side view (x/z), which looks along -Y; a quarter turn counter-clockwise on screen
wpress 3 385.6 300
wdrag 350 390
wdrag 256 429.6
release
expect cam angles 0 90 -90
cameraedit angles 0 0 0
expect cam angles 0 0 0
# -- aim at a clicked point: in a 2D view the point is at the camera's own depth
cameraaim click
wpress 1 256 0
release
expect cam angles 0 90 0
expect cam pos 256 -400 300
# ... and at a typed point (straight down keeps the yaw, the roll stays)
cameraedit angles 0 90 15
cameraaim 256 -400 0
expect cam angles -90 90 15
cameraedit angles -20 120 0
# -- the active camera: make the second one active (one undo step), then back
cameraactive 1
expect cameraactive 1
undo
expect cameraactive 0
redo
expect cameraactive 1
cameraselect 0
cameraedit active 1
expect cameraactive 0
# -- deleting the active camera makes the other one active; undo brings both back
key Delete
expect cameras 1
expect cameraactive 0
expect camerasel 0
undo
expect cameras 2
expect cameraactive 0
# -- duplicate: a new name, offset by the grid, never active
cameraselect 1
duplicate
expect cameras 3
expect camerasel 1
expect cam name camera 3
expect cam pos 272 -384 300
expect cameraactive 0
# -- orthographic, near / far, exposure, colour (typed)
cameraedit ortho 1
cameraedit orthosize 600
cameraedit near 64
cameraedit far 9000
cameraedit exposure -1.5
cameraedit color 60 200 255
expect cam ortho 1
expect cam orthosize 600
expect cam near 64
expect cam far 9000
expect cam exposure -1.5
expect cam color 60 200 255
# -- the select tool picks cameras by their marker; a brush click drops them
tool select
key Esc
expect camerasel 0
wpress 1 -256 0
release
expect camerasel 1
expect selected 0
expect cam name camera 1
wpress 1 264 0
release
expect camerasel 0
expect selected 1
# -- drag a marker in the top view: moves it (snapped)
tool camera
wpress 1 -256 0
wdrag -190 60
release
expect camerasel 1
expect cam pos -192 64 160
# -- Escape deselects, Delete in the camera tool removes cameras only
key Esc
expect camerasel 0
camera -900 -700 650 38 -24
cameraselect 1
shot m11-01-cameras.png
# -- save and open: everything kept, still one active camera
save cams.map
open cams.map
expect cameras 3
expect cameraactive 0
cameraselect 2
expect cam ortho 1
expect cam orthosize 600
expect cam name camera 3
cameraselect 0
expect cam pos -192 64 160
expect cam lens 24
expect cam size 1280 720
cameraselect 1
expect cam angles -20 120 0
tool camera
cameraselect 0
shot m11-02-camera-properties.png
quit
